  "cards": [
    {
      "dot": "cyan",
      "title": "两条主循环家族",
      "items": [
        "6 条继承 ModeRunnerBase：fodder / hero_synthesis / knights_donation / labyrinth_stone / story / world_boss",
        "4 条自写循环：arena / expedition / shop_refresh / survivor",
        "不是漏掉：arena 与 expedition 比 runner_base 早 9 天；survivor 是另一套交互；shop_refresh 是事务式流程",
        "两条并存是明确决定：不拿稳定换整齐"
      ]
    },
    {
      "dot": "emerald",
      "title": "跨项目通用层 core/",
      "items": [
        "window / pc_window：窗口与截图，被最小化会自动还原",
        "matcher：区域限定模板匹配，find_all_templates 处理一屏多个同款按钮",
        "runtime / supervisor：时钟、稳定观测、结论门、看门狗",
        "recovery / hotkey / qqbot：逃生闸门、P 键急停、通知通道",
        "这一层不认识第七史诗，换一个游戏可以整层带走"
      ]
    },
    {
      "dot": "violet",
      "title": "第七史诗专用层 games/epic7/",
      "items": [
        "modes：MODE_SPECS 路线注册表，新增路线要登记的第一处",
        "navigation / global_popups：大厅导航与全局弹窗",
        "battle_controls / battle_supervisor：战斗控件识别与看护",
        "home_return / finish_home：收尾回大厅"
      ]
    },
    {
      "dot": "amber",
      "title": "每一步都要交代进出场",
      "items": [
        "evidence/ 11 个判据模块：先认页面再动手，点完再验一次",
        "转场契约：动作必须声明源页面 + 目标页面或页内证据",
        "判据不准 与 判据没接进主循环 是两类不同的 bug"
      ]
    },
    {
      "dot": "rose",
      "title": "安全与工程护栏",
      "items": [
        "干跑默认；实跑要 --live --confirm RUN 加正的 --max-cycles",
        "危险按钮绝不点：survivor 的确认与重新抽取、arena 的买票",
        "退出码：0 完成 / 1 故障 / 2 资源耗尽 / 130 手动停",
        "tools/check.py 默认定向测试，映射不到只提示；全量用 --full 显式触发"
      ]
    }
  ]
